# Speak Better - what each environment needs.
# Copy to .env.local and fill in. Everything here is optional: without
# it the app runs single-device with the stand-in coach.

# Coach (Gemini) - watching takes, answering questions, the voice
GEMINI_API_KEY=

# Where a take goes to be watched, and is deleted from afterwards
BLOB_READ_WRITE_TOKEN=

# Accounts and the shared record (supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Push notifications (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=

# Payment (Stripe). Without STRIPE_SECRET_KEY the buy buttons unlock
# the device directly, exactly as they did before checkout existed -
# so previews and demos keep working with no keys at all.
#   sk_test_... while testing, sk_live_... for the cohort
STRIPE_SECRET_KEY=
#   From `stripe listen` locally, or the endpoint's signing secret in
#   the dashboard. Without it the webhook refuses every request.
STRIPE_WEBHOOK_SECRET=
#   Needed by the webhook to write a plan onto a profile (it has to go
#   past row-level security). Server only - never in a NEXT_PUBLIC_ key.
SUPABASE_SERVICE_ROLE_KEY=
#   Where Stripe sends people back to. https://..., no trailing slash.
NEXT_PUBLIC_SITE_URL=
#   Optional: Price ids from the dashboard. Left empty, the checkout is
#   built from the cents in src/data/pricing.ts instead.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_FULL=
STRIPE_PRICE_ULTIMATE=
STRIPE_PRICE_UPGRADE=
